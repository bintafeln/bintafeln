#!/usr/bin/env bash
# Betriebswerkzeug für bintafeln. Im Projektordner aufrufen: ./betrieb hilfe
#
# Der gesamte Ablauf steht in Funktionen und startet erst in der letzten Zeile. So liest bash
# das Skript vollständig ein, bevor "update" es per git pull durch eine neue Fassung ersetzt.
set -euo pipefail

NAMENSMUSTER='^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{6}$'

hinweis() { printf '\n==> %s\n' "$*"; }
fehler() { printf 'FEHLER: %s\n' "$*" >&2; exit 1; }

env_wert() {
    local wert=""
    if [[ -f .env ]]; then
        wert=$(grep -E "^$1=" .env | tail -n 1 | cut -d= -f2- || true)
        wert=${wert%\"}
        wert=${wert#\"}
    fi
    printf '%s' "${wert:-${2:-}}"
}

sicherungspfad() { env_wert BINTAFELN_SICHERUNG_PFAD ./sicherungen; }

schluessel_eingetragen() { [[ "$(env_wert BINTAFELN_SICHERUNG_SCHLUESSEL)" == age1* ]]; }

nachfragen() {
    local antwort
    [[ "${BINTAFELN_JA:-}" == 1 ]] && return 0
    read -r -p "$1 [j/N] " antwort
    [[ "$antwort" =~ ^[jJ]$ ]]
}

env_setzen() {
    if grep -qE "^$1=" .env; then
        sed -i "s|^$1=.*|$1=$2|" .env
    else
        printf '%s=%s\n' "$1" "$2" >> .env
    fi
}

befehl_sichern() {
    schluessel_eingetragen || fehler "Kein Sicherungsschlüssel eingetragen. Zuerst: ./betrieb schluessel"
    hinweis "Sicherung wird erstellt"
    docker compose run --rm -T backup jetzt
}

befehl_schluessel() {
    [[ -f .env ]] || fehler "Keine .env gefunden. Zuerst: cp .env.example .env"
    if schluessel_eingetragen; then
        echo "Es ist bereits ein Sicherungsschlüssel eingetragen."
        echo "Ein neuer Schlüssel gilt nur für künftige Sicherungen. Ältere Sicherungen lassen sich"
        echo "weiterhin nur mit dem ALTEN privaten Schlüssel öffnen."
        nachfragen "Trotzdem einen neuen Schlüssel erzeugen?" || exit 1
    fi
    local ausgabe oeffentlich privat
    ausgabe=$(docker compose run --rm --no-deps -T backup schluessel 2>/dev/null)
    oeffentlich=$(sed -n 's/^# public key: //p' <<<"$ausgabe")
    privat=$(grep '^AGE-SECRET-KEY-' <<<"$ausgabe" || true)
    [[ "$oeffentlich" == age1* && -n "$privat" ]] || fehler "Schlüssel konnte nicht erzeugt werden."
    env_setzen BINTAFELN_SICHERUNG_SCHLUESSEL "$oeffentlich"

    cat <<EOF

Der öffentliche Schlüssel ist jetzt in .env eingetragen. Damit verschlüsselt der Server
die Sicherungen. Lesen kann sie nur, wer den folgenden PRIVATEN Schlüssel hat:

$privat

WICHTIG:
  * Diese Zeile jetzt kopieren und NICHT auf diesem Server speichern, sondern getrennt
    aufbewahren (Passwortmanager, ausgedruckt im Tresor, USB-Stick).
  * Ohne diesen Schlüssel ist keine Wiederherstellung möglich.
  * Zum Wiederherstellen die Zeile in eine Datei schreiben, z. B. schluessel.txt.

EOF
    hinweis "Dienste mit neuem Schlüssel neu starten"
    docker compose up -d
}

VERSIONSMUSTER='^[0-9]{4}\.[0-9]{1,2}\.[0-9]+$'

# Veröffentlichte Versionen (Tags der Form JJJJ.M.N, ADR 0023), neueste zuerst.
versionen() {
    git tag --list | grep -E "$VERSIONSMUSTER" | sort -rV || true
}

installierte_version() { git describe --tags --exact-match HEAD 2>/dev/null || true; }

# Zeigt die letzten Versionen zur Auswahl; ohne Eingabe nach 3 Sekunden die neueste.
# Gibt die gewählte Version (oder "main") aus; Liste und Frage gehen nach stderr.
version_waehlen() {
    local installiert="$1" liste=() wahl="" nummer=1 v
    mapfile -t liste < <(versionen | head -n 9)
    if [[ ${#liste[@]} -eq 0 ]]; then
        echo main
        return
    fi
    if [[ ! -t 0 || "${BINTAFELN_JA:-}" == 1 ]]; then
        echo "${liste[0]}"
        return
    fi
    {
        echo
        echo "Welche Version installieren?"
        for v in "${liste[@]}"; do
            printf '  %d) %s' "$nummer" "$v"
            [[ $nummer -eq 1 ]] && printf '  (neueste)'
            [[ "$v" == "$installiert" ]] && printf '  (installiert)'
            echo
            nummer=$((nummer + 1))
        done
        echo "  m) Entwicklungsstand (main, zum Testen)"
    } >&2
    read -r -t 3 -p "Auswahl [1, nach 3 Sekunden automatisch]: " wahl || true
    echo >&2
    wahl="${wahl:-1}"
    if [[ "$wahl" == [mM] ]]; then
        echo main
    elif [[ "$wahl" =~ ^[0-9]+$ ]] && (( wahl >= 1 && wahl <= ${#liste[@]} )); then
        echo "${liste[$((wahl - 1))]}"
    else
        fehler "Ungültige Auswahl '$wahl'."
    fi
}

# Setzt die Datenbank auf den Stand von Version $1 zurück, solange noch der neuere Code läuft:
# je App auf die letzte Migration, die es in der älteren Version gab ("zero" = gab es nicht).
migrationen_zuruecksetzen() {
    local ziel="$1" ordner app letzte aktuell stand
    hinweis "Datenbank auf den Stand von $ziel zurücksetzen"
    docker compose stop app proxy
    for ordner in apps/*/migrations; do
        app=$(basename "$(dirname "$ordner")")
        letzte=$(git ls-tree --name-only "$ziel" "$ordner/" | sed 's#.*/##' \
            | grep -E '^[0-9]{4}_.*\.py$' | sort | tail -n 1 || true)
        aktuell=$(find "$ordner" -maxdepth 1 -name '[0-9][0-9][0-9][0-9]_*.py' | sed 's#.*/##' \
            | sort | tail -n 1)
        stand="${letzte%.py}"
        [[ "$stand" == "${aktuell%.py}" ]] && continue
        echo "  $app: zurück auf ${stand:-zero}"
        if ! docker compose run --rm --no-deps -T app \
            python manage.py migrate "$app" "${stand:-zero}" --noinput; then
            docker compose start app proxy
            fehler "Zurücksetzen nicht möglich. Es bleibt beim bisherigen Stand; die Sicherung von eben enthält alles."
        fi
    done
}

befehl_update() {
    local ziel="${1:-}" installiert rueckwaerts=""
    [[ -f .env ]] || fehler "Keine .env gefunden. Zuerst die Installation laut README durchführen."
    hinweis "Versionen abrufen"
    git fetch --quiet --tags --force origin
    installiert=$(installierte_version)
    echo "Installiert: ${installiert:-$(git rev-parse --short HEAD) (keine Version)}"
    [[ -n "$ziel" ]] || ziel=$(version_waehlen "$installiert")
    if [[ "$ziel" != main ]]; then
        git rev-parse --quiet --verify "refs/tags/$ziel" >/dev/null \
            || fehler "Version '$ziel' gibt es nicht. Möglich: ./betrieb update [VERSION|main]"
        if ! git merge-base --is-ancestor HEAD "$ziel"; then
            rueckwaerts=1
            echo
            echo "ACHTUNG: $ziel ist älter als der installierte Stand. Die Datenbank wird auf den"
            echo "Stand dieser Version zurückgesetzt. Was nur die neuere Version speichert (z. B. neue"
            echo "Felder oder Bereiche), geht dabei verloren. Vorher wird gesichert."
            nachfragen "Auf $ziel zurückgehen?" || exit 1
        fi
    fi
    echo "Ziel: $ziel"
    hinweis "Sicherung vor dem Update"
    if schluessel_eingetragen; then
        befehl_sichern
    else
        echo "Es ist noch kein Sicherungsschlüssel eingetragen, vor dem Update wird nicht gesichert."
        nachfragen "Ohne Sicherung fortfahren?" || exit 1
    fi
    [[ -z "$rueckwaerts" ]] || migrationen_zuruecksetzen "$ziel"
    hinweis "Stand $ziel holen"
    if [[ "$ziel" == main ]]; then
        git checkout --quiet main
        git pull --ff-only origin main
    else
        git checkout --quiet "$ziel"
    fi
    # Die übrigen Schritte führt die gerade geholte Fassung dieses Skripts aus.
    exec ./betrieb _update_fortsetzen
}

befehl_update_fortsetzen() {
    # Die Anwendung zeigt diese Angabe Admins in der Fußzeile.
    git describe --tags --exact-match 2>/dev/null > VERSION \
        || printf 'main-%s\n' "$(git rev-parse --short HEAD)" > VERSION
    hinweis "Images aktualisieren und neu bauen"
    docker compose pull db proxy
    docker compose build --pull
    hinweis "Neu starten (Migrationen laufen automatisch)"
    docker compose up -d --wait
    hinweis "Alte Images aufräumen"
    # Nur Images ohne Namen: die durch den Neubau ersetzten Stände. Ältere Versionen lassen sich
    # jederzeit wieder aus dem Repository bauen.
    docker image prune -f
    befehl_status
}

befehl_wiederherstellen() {
    local name="" schluessel=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --schluessel) schluessel="${2:-}"; shift 2 ;;
            --ja) BINTAFELN_JA=1; shift ;;
            *) name="$1"; shift ;;
        esac
    done
    local pfad
    pfad=$(sicherungspfad)
    [[ "$name" =~ $NAMENSMUSTER ]] \
        || fehler "Bitte den Namen einer Sicherung angeben, z. B.: ./betrieb wiederherstellen 2026-01-31_023000 --schluessel schluessel.txt (Liste: ./betrieb status)"
    [[ -f "$pfad/$name/info.txt" ]] || fehler "Sicherung $name nicht gefunden oder unvollständig."
    [[ -n "$schluessel" ]] || read -r -p "Pfad zur Datei mit dem privaten Schlüssel: " schluessel
    [[ -f "$schluessel" ]] || fehler "Schlüsseldatei '$schluessel' nicht gefunden."
    schluessel=$(readlink -f "$schluessel")

    hinweis "Sicherung $name prüfen"
    cat "$pfad/$name/info.txt"
    docker compose run --rm --no-deps -T -v "$schluessel:/schluessel:ro" backup pruefen "$name"

    cat <<EOF

ACHTUNG: Der aktuelle Datenbestand wird vollständig durch die Sicherung $name ersetzt.
Alle Änderungen seit dieser Sicherung gehen verloren. Vorher wird der jetzige Stand gesichert.
EOF
    nachfragen "Wiederherstellen?" || exit 1

    if schluessel_eingetragen; then
        befehl_sichern
    else
        nachfragen "Kein Sicherungsschlüssel eingetragen, aktueller Stand wird NICHT gesichert. Fortfahren?" \
            || exit 1
    fi

    hinweis "Anwendung anhalten"
    docker compose stop app proxy

    hinweis "Datenbank wiederherstellen"
    docker compose run --rm --no-deps -T -v "$schluessel:/schluessel:ro" backup entschluesseln "$name" datenbank \
        | docker compose exec -T db sh -c '
            export PGOPTIONS="-c client_min_messages=warning"
            { echo "DROP SCHEMA public CASCADE; CREATE SCHEMA public;"; pg_restore --no-owner --no-privileges -f -; } \
              | psql -q -v ON_ERROR_STOP=1 --single-transaction -U "$POSTGRES_USER" -d "$POSTGRES_DB" > /dev/null'

    hinweis "Hochgeladene Dateien wiederherstellen"
    docker compose run --rm --no-deps -T -v "$schluessel:/schluessel:ro" backup entschluesseln "$name" medien \
        | docker compose run --rm --no-deps -T --entrypoint sh app -c \
            'find /app/data/media -mindepth 1 -delete && tar -xf - -C /app/data/media'

    hinweis "Anwendung starten (Migrationen laufen automatisch)"
    docker compose up -d --wait
    echo
    echo "Sicherung $name wurde wiederhergestellt."
}

befehl_status() {
    hinweis "Version"
    if [[ -f VERSION ]]; then sed 's/^/  /' VERSION; else echo "  unbekannt (erst nach ./betrieb update)"; fi
    hinweis "Dienste"
    docker compose ps
    local pfad
    pfad=$(sicherungspfad)
    hinweis "Sicherung"
    if [[ -f "$pfad/status.txt" ]]; then
        sed 's/^/  /' "$pfad/status.txt"
    else
        echo "  Noch keine Sicherung gelaufen."
    fi
    hinweis "Vorhandene Sicherungen (neueste zuerst)"
    if [[ -d "$pfad" ]]; then
        find "$pfad" -mindepth 1 -maxdepth 1 -type d | sed 's#.*/##' | grep -E "$NAMENSMUSTER" \
            | sort -r | sed 's/^/  /' || echo "  keine"
    else
        echo "  keine"
    fi
}

befehl_hilfe() {
    cat <<'EOF'
Betriebswerkzeug für bintafeln

  ./betrieb update                     Version wählen (nach 3 Sekunden die neueste), sichern,
                                         holen, neu bauen und starten; auch zurück auf ältere
  ./betrieb update VERSION             direkt diese Version, z. B. 2026.10.5
  ./betrieb update main                neuester Entwicklungsstand (zum Testen)
  ./betrieb sichern                    sofort eine Sicherung erstellen
  ./betrieb schluessel                 Schlüsselpaar für die Sicherungen erzeugen
  ./betrieb wiederherstellen NAME [--schluessel DATEI] [--ja]
                                         eine Sicherung zurückspielen
  ./betrieb status                     Dienste, letzte Sicherung und vorhandene Stände
EOF
}

main() {
    cd "$(dirname "$(readlink -f "$0")")"
    local befehl="${1:-hilfe}"
    shift || true
    case "$befehl" in
        update) befehl_update "$@" ;;
        _update_fortsetzen) befehl_update_fortsetzen ;;
        sichern) befehl_sichern ;;
        schluessel) befehl_schluessel ;;
        wiederherstellen) befehl_wiederherstellen "$@" ;;
        status) befehl_status ;;
        hilfe|-h|--help) befehl_hilfe ;;
        *) befehl_hilfe; exit 2 ;;
    esac
}

main "$@"
exit
