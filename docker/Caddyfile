# Caddy-Konfiguration für bintafeln.
# SITE_ADDRESS kommt aus docker-compose.yml:
#   ":80"               → Entwicklungsmodus, http://IP ohne TLS
#   "tafel.example.org" → Produktionsmodus, automatisches TLS (Let's Encrypt)
# Hinter einem gemeinsamen Proxy (docker/hinter-proxy.yml) ist SITE_ADDRESS ":80" und
# BINTAFELN_VERTRAUTE_PROXYS "private_ranges": Caddy übernimmt dann https und die Adresse der
# Besucher aus den Kopfzeilen des gemeinsamen Proxys.

{
	servers {
		trusted_proxies static {$BINTAFELN_VERTRAUTE_PROXYS:127.0.0.1/32}
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		-Server
	}

	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Nur ausdrücklich öffentliche Uploads (z. B. das Logo) werden direkt ausgeliefert.
	# Alle anderen Medien bleiben hinter der Anmeldung der App.
	handle_path /media/oeffentlich/* {
		root * /srv/media/oeffentlich
		file_server
	}

	handle {
		reverse_proxy app:8000
	}
}
