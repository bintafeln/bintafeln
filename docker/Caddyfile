# Caddy-Konfiguration für bintafeln.
# SITE_ADDRESS kommt aus docker-compose.yml:
#   ":80"               → Entwicklungsmodus, http://IP ohne TLS
#   "tafel.example.org" → Produktionsmodus, automatisches TLS (Let's Encrypt)
# Hinter einem gemeinsamen Proxy (docker/hinter-proxy.yml) ist SITE_ADDRESS ":80" und
# BINTAFELN_VERTRAUTE_PROXYS "private_ranges": Caddy übernimmt dann https und die Adresse der
# Besucher aus den Kopfzeilen des gemeinsamen Proxys.
#
# https im Heimnetz (ADR 0041): Ist BINTAFELN_HEIMNETZ_ADRESSE gesetzt (z. B. die IP der VM), liefert
# Caddy diese Adresse zusätzlich über https mit einem selbst ausgestellten Zertifikat aus. Das
# braucht z. B. die Kamera am Handy, die Browser nur über https freigeben. Ohne Variable
# (docker-compose.yml setzt dann den Platzhalter „heimnetz.invalid“) antworten die beiden letzten
# Blöcke nur auf diesen Platzhalter, also nie. Leer darf die Variable nicht sein.
{
	servers {
		trusted_proxies static {$BINTAFELN_VERTRAUTE_PROXYS:127.0.0.1/32}
	}
	# Geräte im Heimnetz rufen die IP ohne Namen (SNI) auf; dann gilt das Zertifikat dieser Adresse
	default_sni {$BINTAFELN_HEIMNETZ_ADRESSE:heimnetz.invalid}
	# Die eigene Zertifizierungsstelle nicht im Container installieren (dort nutzlos)
	skip_install_trust
}

(bintafeln) {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		# Nur, wenn die App nichts anderes sagt (PDF-Infos des Monitors: SAMEORIGIN)
		?X-Frame-Options DENY
		-Server
	}

	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Nur ausdrücklich öffentliche Uploads (z. B. das Logo) werden direkt ausgeliefert.
	# Alle anderen Medien bleiben hinter der Anmeldung der App.
	handle_path /media/oeffentlich/* {
		root * /srv/media/oeffentlich
		file_server
	}

	handle {
		reverse_proxy app:8000
	}
}

{$SITE_ADDRESS} {
	import bintafeln
}

https://{$BINTAFELN_HEIMNETZ_ADRESSE:heimnetz.invalid} {
	tls internal
	import bintafeln
}

# Eigener http-Block, damit http://IP weiter ohne Umleitung auf https funktioniert
http://{$BINTAFELN_HEIMNETZ_ADRESSE:heimnetz.invalid} {
	import bintafeln
}
