# bintafeln – Konfiguration
# Kopieren nach .env und anpassen:  cp .env.example .env
# Die Datei .env niemals ins Repository einchecken!

# --- Pflichtwerte -------------------------------------------------------
# Langer Zufallswert, z. B. erzeugen mit:  openssl rand -base64 48
DJANGO_SECRET_KEY=
# Datenbank-Passwort, z. B. erzeugen mit:  openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Betriebsmodus ------------------------------------------------------
# Leer lassen  → Entwicklungsmodus: Zugriff über http://IP-des-Servers, kein TLS.
# Domain setzen → Produktionsmodus: Caddy holt automatisch ein TLS-Zertifikat.
#                 Voraussetzung: DNS zeigt auf den Server, Ports 80 und 443 offen.
# Beispiel: BINTAFELN_DOMAIN=tafel.example.org
BINTAFELN_DOMAIN=

# Nur Entwicklungsmodus, z. B. Test im Heimnetz: IP-Adresse des Servers (z. B. 192.168.178.20).
# Dann ist bintafeln zusätzlich unter https://IP erreichbar (selbst ausgestelltes Zertifikat,
# Warnung im Browser einmal bestätigen). Nötig für die Kamera am Handy, die Browser nur über
# https freigeben. http://IP funktioniert weiter.
BINTAFELN_HEIMNETZ_ADRESSE=

# --- Sicherung ----------------------------------------------------------
# Öffentlicher Schlüssel (beginnt mit age1…). Am einfachsten erzeugen mit:
#   ./betrieb schluessel
# Ohne Schlüssel wird nicht gesichert – unverschlüsselt wird nie gesichert.
BINTAFELN_SICHERUNG_SCHLUESSEL=
# Uhrzeit und Anzahl gelten nur für die erste Einrichtung des Standard-Auftrags. Danach stellt
# man Zeitpläne, Aufbewahrung und weitere Ziele (z. B. USB-Platte) in bintafeln ein:
# „Einstellungen → Sicherungen“ (ADR 0042).
BINTAFELN_SICHERUNG_UHRZEIT=02:30
BINTAFELN_SICHERUNG_ANZAHL=14
# Ablageort auf dem Server (relativ zum Projektordner oder absolut)
BINTAFELN_SICHERUNG_PFAD=./sicherungen

# --- Mehrere Installationen auf einem Server (README, ADR 0022) ---------
# Jede Installation in einem eigenen Ordner mit eigenem, eindeutigem Namen, z. B. demo.
# Hinter dem gemeinsamen Proxy zusätzlich die zweite Zeile einschalten.
#COMPOSE_PROJECT_NAME=demo
#COMPOSE_FILE=docker-compose.yml:docker/hinter-proxy.yml

# --- Öffentliche Demo (README, ADR 0022) ---------------------------------
# Nur für eine Demo mit erfundenen Daten! Zeigt die Zugänge auf der Anmeldeseite und erlaubt
#   docker compose exec app python manage.py demo_zuruecksetzen   (löscht ALLE Daten)
BINTAFELN_DEMO=false
BINTAFELN_DEMO_PASSWORT=

# --- bintafeln-Verzeichnis (ADR 0089) --------------------------------------
# Jede Tafel kann sich freiwillig unter „Einstellungen → Tafel → bintafeln-Verzeichnis“ melden
# (Name, Kontakt-Mail, Version). Leer = Adresse des Herausgebers aus bintafeln/programm.py.
BINTAFELN_VERZEICHNIS_URL=
# Nur auf der Installation des Herausgebers: Meldungen annehmen und als Liste zeigen.
BINTAFELN_VERZEICHNIS_EMPFANG=false

# --- Optional -----------------------------------------------------------
# Ports auf dem Server
HTTP_PORT=80
HTTPS_PORT=443

BINTAFELN_ZEITZONE=Europe/Berlin
BINTAFELN_LOGLEVEL=INFO

# Nur zur Fehlersuche, niemals im Echtbetrieb:
DJANGO_DEBUG=false

# Standard: im Entwicklungsmodus alle Hosts, im Produktionsmodus nur die Domain.
# Mehrere Werte durch Komma trennen.
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=bintafeln
POSTGRES_USER=bintafeln
